{
    "name": "websitesql/utilities",
    "description": "A lightweight set of utilities from Website SQL.",
    "homepage": "https://www.websitesql.com",
    "minimum-stability": "stable",
    "type": "framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Alan Tiller",
            "email": "alan@alantiller.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "WebsiteSQL\\Utilities\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
