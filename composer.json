{
    "name": "alantiller/utilities",
    "description": "Framework-independent PHP helpers for dates, strings, UUIDs, encoding and validation.",
    "type": "library",
    "license": "MIT",
    "authors": [
		{
			"name": "Alan Tiller",
			"email": "alan@alantiller.com"
		}
	],
    "require": {
		"php": ">=8.1",
		"php-64bit": ">=8.1",
		"ext-mbstring": "*"
	},
    "require-dev": {
		"phpunit/phpunit": "^10.5",
		"phpstan/phpstan": "^2.1"
	},
    "autoload": {
		"psr-4": {
			"Alantiller\\": "src/",
			"Alantiller\\Utilities\\Helpers": "src/Helpers"
		}
	},
    "autoload-dev": {
		"psr-4": {
			"Alantiller\\Utilities\\Tests\\": "tests/"
		}
	},
    "scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --no-progress",
		"check": ["@analyse", "@test"]
	}
}
